rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the user is a Teacher
    function isTeacher() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "Teacher";
    }

    // Check if the user is an Admin
    function isAdmin() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "Admin";
    }

    // --- Users Collection ---
    match /users/{userId} {
      // Anyone authenticated can view their own profile, or if they are a teacher/admin they can read other profiles.
      // (Teachers might need to read student profiles to show their name/status)
      allow read: if isAuthenticated();
      // Users can only create/update their own profile, unless they are admin.
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // --- Quiz Scores Collection ---
    match /quiz_scores/{scoreId} {
      // Admins/Teachers can read all scores. Students can read their own.
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.user_id || 
        isTeacher() || 
        isAdmin()
      );
      // Only the user themselves can submit/update their score
      allow create, update: if isAuthenticated() && request.auth.uid == request.resource.data.user_id;
      allow delete: if isAdmin();
    }

    // --- Activity Feed Collection ---
    match /activity_feed/{activityId} {
      // Teachers and Admins can view activity feeds
      allow read: if isAuthenticated();
      // Any authenticated user can create an activity log (we trust the client payload for standard operations here)
      allow create: if isAuthenticated() && request.resource.data.actorUid == request.auth.uid;
      // Activity logs should be immutable
      allow update: if false;
      allow delete: if isAdmin();
    }

    // --- Assignments Collection ---
    match /assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow create, update: if isTeacher() || isAdmin();
      allow delete: if isTeacher() || isAdmin();
    }
  }
}
