rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the user is a Teacher
    function isTeacher() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "Teacher";
    }

    // Check if the user is an Admin
    function isAdmin() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "Admin";
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      // Users can update own profile but NOT change their role, unless Admin
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
      );
      allow delete: if isAdmin();
    }

    // --- Lab Progress Sub-collection ---
    match /labProgress/{uid}/labs/{labId} {
      // Only the student themselves can write their lab progress
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.auth.uid == uid;
      allow delete: if isAdmin();
    }

    // --- Teachers Collection ---
    match /teachers/{teacherUid} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (request.auth.uid == teacherUid || isAdmin());
      allow delete: if isAdmin();

      // Sub-collection: students under a teacher
      match /students/{studentUid} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAuthenticated() && (
          request.auth.uid == studentUid || 
          request.auth.uid == teacherUid || 
          isAdmin()
        );
      }
    }

    // --- Teacher Codes (O(1) lookup) ---
    match /teacherCodes/{code} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (isTeacher() || isAdmin());
      allow delete: if isAdmin();
    }

    // --- Quiz Scores Collection ---
    match /quiz_scores/{scoreId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.user_id || 
        isTeacher() || 
        isAdmin()
      );
      allow create, update: if isAuthenticated() && request.auth.uid == request.resource.data.user_id;
      allow delete: if isAdmin();
    }

    // --- Activity Feed (legacy name) ---
    match /activity_feed/{activityId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.actorUid == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // --- Activity Feed (new name) ---
    match /activityFeed/{activityId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.actorUid == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // --- Feedbacks Collection ---
    match /feedbacks/{feedbackId} {
      allow read: if isAuthenticated() && (isAdmin() || isTeacher());
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- Password Reset Requests ---
    match /passwordResetRequests/{requestId} {
      allow read: if isAuthenticated() && (isAdmin() || isTeacher());
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- Assignments Collection ---
    match /assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow create, update: if isTeacher() || isAdmin();
      allow delete: if isTeacher() || isAdmin();
    }
  }
}
